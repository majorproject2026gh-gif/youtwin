PORT=4000
DATABASE_URL=postgresql://youtwin:youtwin@localhost:5432/youtwin
AI_SERVICE_URL=http://localhost:8000

# Google OAuth (free — create in Google Cloud Console)
GOOGLE_CLIENT_ID=
# No client secret needed — the auth flow only verifies Google ID tokens
# and requests access tokens client-side (Google Identity Services),
# neither of which uses a secret.
JWT_SECRET=change-me-to-a-long-random-string

FRONTEND_URL=http://localhost:3000
# Number of reverse proxies in front of this service (Render/Vercel: 1).
TRUST_PROXY_HOPS=1

# Must exactly match AI_SERVICE_SECRET in ai-service/.env — required
# once ai-service is deployed publicly (see DEPLOYMENT.md), otherwise
# leave both blank for local dev.
AI_SERVICE_SECRET=
