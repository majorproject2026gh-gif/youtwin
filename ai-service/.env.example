# ---- Vector DB (M3) ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ---- LLM (M4) ----
# The RAG chain (LangChain LCEL, app/rag.py) calls whichever provider is set:
#   ollama        - free, local. OLLAMA_MODEL=llama3:70b runs the spec's
#                   Llama-3-70B on a GPU box with enough VRAM (~40 GB 4-bit).
#   openai_compat - any OpenAI-compatible server hosting Llama-3-70B
#                   (vLLM on the AWS EC2 g5 node from the spec sheet,
#                   Together, OpenRouter, Fireworks, ...)
#   groq          - free hosted tier. Groq retired Llama-3.3-70B from its
#                   free plan in Aug 2026, hence gpt-oss-120b as the default.
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=meta-llama/Meta-Llama-3-70B-Instruct
LLM_TIMEOUT_SECONDS=40
# Cap per LLM call; reasoning models (gpt-oss) spend part of it thinking.
LLM_MAX_TOKENS=700

# ---- Video generation agent (M-Video) ----
# Free trial credit at signup, pay-per-generation after. Sign up at
# replicate.com, create an API token under Account Settings > API tokens.
REPLICATE_API_TOKEN=
# Leave blank to use the default model (zeroscope-v2-xl)
REPLICATE_MODEL_VERSION=

# ---- YouTube ingestion (M1) ----
# Optional. Without this, ingestion falls back to youtube-transcript-api only
# (captions, no channel search) or mock/sample data.
YOUTUBE_API_KEY=

# ---- Whisper fallback (M1) ----
# auto = large-v3 (the spec's Whisper-v3) when WHISPER_DEVICE=cuda,
# base on CPU. Or force one: tiny|base|small|medium|large-v3
WHISPER_MODEL_SIZE=auto
WHISPER_DEVICE=cpu

# ---- Embeddings (M3) ----
# Changing it re-embeds each twin's index on its next question.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---- Guardrail (M4) ----
# 0-1 calibrated confidence (app/rag.py); below it the twin refuses.
# 0.55 lets ~97% of answerable questions through on the evaluation set
# (ai-service/eval) while refusing most off-topic ones; the LLM's own
# NOT_IN_CONTEXT check catches the rest.
RAG_MIN_CONFIDENCE=0.55

# ---- Durable store + caching (Redis, free via Upstash) ----
# Optional but strongly recommended before any real/concurrent usage —
# without this, ingest status/personas live in an in-memory dict that's
# wiped on restart and unsafe with more than one server process.
# Get free credentials at https://console.upstash.com (Redis > Create DB
# > REST API section gives you both values below).
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# ---- Internal auth (required once this service is deployed publicly —
# see DEPLOYMENT.md; leave blank for local dev, no effect either way) ----
AI_SERVICE_SECRET=
