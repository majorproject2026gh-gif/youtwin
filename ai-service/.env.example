# ---- Vector DB (M3) ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ---- LLM (M4) ----
# "ollama" (free, local, default) or "groq" (free-tier hosted Llama-3-70B)
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---- Video generation agent (M-Video) ----
# Free trial credit at signup, pay-per-generation after. Sign up at
# replicate.com, create an API token under Account Settings > API tokens.
REPLICATE_API_TOKEN=
# Leave blank to use the default model (zeroscope-v2-xl)
REPLICATE_MODEL_VERSION=

# ---- YouTube ingestion (M1) ----
# Optional. Without this, ingestion falls back to youtube-transcript-api only
# (captions, no channel search) or mock/sample data.
YOUTUBE_API_KEY=

# ---- Whisper fallback (M1) ----
WHISPER_MODEL_SIZE=base
# tiny|base|small|medium|large-v3  (large-v3 = the real "Whisper-v3" from the slides,
# needs a GPU to be fast; "base" is fine for CPU demo use)
WHISPER_DEVICE=cpu

# ---- Guardrail (M4) ----
RAG_MIN_CONFIDENCE=0.35

# ---- Durable store + caching (Redis, free via Upstash) ----
# Optional but strongly recommended before any real/concurrent usage —
# without this, ingest status/personas live in an in-memory dict that's
# wiped on restart and unsafe with more than one server process.
# Get free credentials at https://console.upstash.com (Redis > Create DB
# > REST API section gives you both values below).
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
